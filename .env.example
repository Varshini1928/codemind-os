# Copy to .env and edit. All values are optional; defaults are shown.
# Where indexes, graphs, reports and caches are stored (outside your repositories):
CODEMIND_STORAGE_DIR=~/.codemind_os
# Local LLM (Ollama must be installed and the model pulled by you):
CODEMIND_OLLAMA_HOST=http://127.0.0.1:11434
CODEMIND_OLLAMA_MODEL=qwen2.5-coder:7b
CODEMIND_OLLAMA_TIMEOUT_S=180
# Embeddings: auto | sentence-transformers | hashing. Downloading weights needs your explicit consent:
CODEMIND_EMBEDDING_BACKEND=auto
CODEMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CODEMIND_ALLOW_MODEL_DOWNLOAD=false
CODEMIND_VECTOR_BACKEND=auto
# Safety switches (default: read-only, nothing executed):
CODEMIND_ALLOW_REPO_WRITES=false
CODEMIND_ALLOW_TEST_EXECUTION=false
CODEMIND_ALLOW_REMOTE_OLLAMA=false
# Cloning is disabled until you name an explicit workspace:
# CODEMIND_CLONE_WORKSPACE=~/codemind_workspace
# API (loopback only unless you opt in; the API has no authentication):
CODEMIND_API_HOST=127.0.0.1
CODEMIND_API_PORT=8000
CODEMIND_ALLOW_NETWORK_BIND=false
# Retrieval ranking weights (normalised per search): semantic, graph, lexical, recency
CODEMIND_ALPHA=0.45
CODEMIND_BETA=0.20
CODEMIND_GAMMA=0.30
CODEMIND_DELTA=0.05
CODEMIND_TOP_K=12

# --- User accounts (the first account created on a local install becomes the administrator) ---
# CODEMIND_AUTH_MODE=accounts          # accounts (default) | none (single local operator, no login; not allowed when hosted)
# CODEMIND_SIGNUP_MODE=open            # open (local default) | approval (hosted default; admin approves) | closed
# CODEMIND_ADMIN_EMAIL=you@example.com # optional locally, REQUIRED when hosted (seeds the administrator)
# CODEMIND_ADMIN_PASSWORD=             # at least 10 characters; used only to create the account the first time
# CODEMIND_MAX_REPOS_PER_USER=10       # 0 = unlimited; administrators are exempt
# CODEMIND_SESSION_TTL_HOURS=168
# CODEMIND_SESSION_IDLE_HOURS=24

# --- Hosted deployment (e.g. Render; see docs/DEPLOY_RENDER.md). Leave unset for local use. ---
# CODEMIND_HOSTED=true                 # forces accounts, disables local paths/writes/test execution, requires an admin
# CODEMIND_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# CODEMIND_MAX_CLONE_MB=200
